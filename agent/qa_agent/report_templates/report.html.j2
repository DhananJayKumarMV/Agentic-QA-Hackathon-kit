<script>
(function () {
  var buttons = document.querySelectorAll(".filters button");
  buttons.forEach(function (b) {
    b.addEventListener("click", function () {
      var f = b.getAttribute("data-filter");
      buttons.forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
      document.querySelectorAll("#req-table tbody tr").forEach(function (tr) {
        tr.hidden = !(f === "all" || tr.getAttribute("data-status") === f);
      });
    });
  });
  var lb = document.getElementById("lightbox"), lbImg = lb.querySelector("img");
  document.querySelectorAll("img.zoom").forEach(function (img) {
    img.addEventListener("click", function () { lbImg.src = img.src; lbImg.alt = img.alt; lb.classList.add("open"); });
  });
  lb.addEventListener("click", function () { lb.classList.remove("open"); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") lb.classList.remove("open"); });
  window.addEventListener("beforeprint", function () {
    document.querySelectorAll("details").forEach(function (d) { d.open = true; });
  });
})();
</script>
